        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "checkbox",
      "id": "eyebrow_left_italic",
      "label": "Left eyebrow italic",
      "default": false
    },
    {
      "type": "checkbox",
