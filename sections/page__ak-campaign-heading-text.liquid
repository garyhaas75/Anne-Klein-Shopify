{% comment %}
  AK Campaign — heading text block: left eyebrow | centered heading | right eyebrow
  (same caption-row logic as page__ak-campaign-two-up-text, without images).
  Optional body + attribution below.
  WCAG 2.2 AA: region, heading level, link focus-visible in RTE.
{% endcomment %}

{% assign id = section.id %}
{% assign heading = section.settings.heading %}
{% assign hl = section.settings.heading_level | default: 'h2' %}
{% assign eyebrow_left = section.settings.eyebrow_left %}
{% assign eyebrow_right = section.settings.eyebrow_right %}
{% assign body_rt = section.settings.body %}
{% assign attr = section.settings.attribution %}
{% assign text_align = section.settings.text_alignment | default: 'center' %}
{% assign bg = section.settings.background_color | default: '#ffffff' %}
{% assign text_color = section.settings.text_color | default: '#000000' %}
{% assign attr_color = section.settings.attribution_color | default: '#000000' %}
{% assign heading_color = section.settings.heading_color | default: text_color %}
{% assign eyebrow_left_color = section.settings.eyebrow_left_color | default: text_color %}
{% assign eyebrow_right_color = section.settings.eyebrow_right_color | default: text_color %}
{% assign max_w_text = section.settings.content_max_width | default: 48 %}
{% assign max_w_text_m = section.settings.content_max_width_mobile | default: 0 | plus: 0 %}
{% if max_w_text_m < 1 %}
  {% assign max_w_text_m = max_w_text %}
{% endif %}
{% assign pad_x = section.settings.content_padding_x | default: 0 | plus: 0 %}
{% assign pad_x_m = section.settings.content_padding_x_mobile | default: 10 | plus: 0 %}
{% assign ht_h = section.settings.heading_font_size | default: 32 %}
{% assign ht_h_m = section.settings.heading_font_size_mobile | default: 0 | plus: 0 %}
{% if ht_h_m < 1 %}
  {% assign ht_h_m = ht_h %}
{% endif %}
{% assign ht_eb_l = section.settings.eyebrow_left_font_size | default: 16 %}
{% assign ht_eb_l_m = section.settings.eyebrow_left_font_size_mobile | default: 0 | plus: 0 %}
{% if ht_eb_l_m < 1 %}
  {% assign ht_eb_l_m = ht_eb_l %}
{% endif %}
{% assign ht_eb_r = section.settings.eyebrow_right_font_size | default: 16 %}
{% assign ht_eb_r_m = section.settings.eyebrow_right_font_size_mobile | default: 0 | plus: 0 %}
{% if ht_eb_r_m < 1 %}
  {% assign ht_eb_r_m = ht_eb_r %}
{% endif %}
{% assign ht_b = section.settings.body_font_size | default: 20 %}
{% assign ht_b_m = section.settings.body_font_size_mobile | default: 0 | plus: 0 %}
{% if ht_b_m < 1 %}
  {% assign ht_b_m = ht_b %}
{% endif %}
{% assign ht_attr = section.settings.attribution_font_size | default: 16 %}
{% assign ht_attr_m = section.settings.attribution_font_size_mobile | default: 0 | plus: 0 %}
{% if ht_attr_m < 1 %}
  {% assign ht_attr_m = ht_attr %}
{% endif %}
{% assign ht_lh = section.settings.body_line_height | default: 150 %}
{% assign ht_lh_m = section.settings.body_line_height_mobile | default: 0 | plus: 0 %}
{% if ht_lh_m < 1 %}
  {% assign ht_lh_m = ht_lh %}
{% endif %}
{% assign eyebrow_gap_d = section.settings.eyebrow_gap_desktop | default: 24 %}
{% assign eyebrow_gap_m = section.settings.eyebrow_gap_mobile | default: 12 %}
{% assign eyebrow_pad_l = section.settings.eyebrow_left_padding | default: 20 %}
{% assign eyebrow_pad_l_m = section.settings.eyebrow_left_padding_mobile | default: 0 | plus: 0 %}
{% if eyebrow_pad_l_m < 1 %}
  {% assign eyebrow_pad_l_m = eyebrow_pad_l %}
{% endif %}
{% assign eyebrow_pad_r = section.settings.eyebrow_right_padding | default: 20 %}
{% assign eyebrow_pad_r_m = section.settings.eyebrow_right_padding_mobile | default: 0 | plus: 0 %}
{% if eyebrow_pad_r_m < 1 %}
  {% assign eyebrow_pad_r_m = eyebrow_pad_r %}
{% endif %}

{% if section.settings.heading_font_family == 'amiri'
  or section.settings.eyebrow_left_font_family == 'amiri'
  or section.settings.eyebrow_right_font_family == 'amiri'
  or section.settings.body_font_family == 'amiri'
  or section.settings.attribution_font_family == 'amiri'
%}
  {% render 'ak-campaign-fonts' %}
{% endif %}

{% capture heading_font_stack %}{% render 'ak-campaign-font-stack', font_key: section.settings.heading_font_family %}{% endcapture %}
{% assign heading_font_stack = heading_font_stack | strip %}
{% capture eyebrow_left_font_stack %}{% render 'ak-campaign-font-stack', font_key: section.settings.eyebrow_left_font_family %}{% endcapture %}
{% assign eyebrow_left_font_stack = eyebrow_left_font_stack | strip %}
{% capture eyebrow_right_font_stack %}{% render 'ak-campaign-font-stack', font_key: section.settings.eyebrow_right_font_family %}{% endcapture %}
{% assign eyebrow_right_font_stack = eyebrow_right_font_stack | strip %}
{% capture body_font_stack %}{% render 'ak-campaign-font-stack', font_key: section.settings.body_font_family %}{% endcapture %}
{% assign body_font_stack = body_font_stack | strip %}
{% capture attr_font_stack %}{% render 'ak-campaign-font-stack', font_key: section.settings.attribution_font_family %}{% endcapture %}
{% assign attr_font_stack = attr_font_stack | strip %}

{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ bg }};
    overflow: hidden;
    max-width: 100%;
    box-sizing: border-box;
  }
  @media only screen and (max-width: 798px) {
    #shopify-section-{{ id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: section.settings.padding_top | default: 40 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom | default: 40 }}px;
    }
  }
  #shopify-section-{{ id }} .ak-heading-text {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    color: {{ text_color }};
    padding-left: {{ pad_x }}px;
    padding-right: {{ pad_x }}px;
    box-sizing: border-box;
  }
  #shopify-section-{{ id }} .ak-heading-text__caption-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    gap: {{ eyebrow_gap_d }}px;
    width: 100%;
    min-width: 0;
  }
  #shopify-section-{{ id }} .ak-heading-text__heading {
    flex: 1 1 0;
    min-width: 0;
    font-family: {{ heading_font_stack }};
    font-size: {{ ht_h }}px;
    font-weight: {{ section.settings.heading_font_weight | default: '400' }};
    font-style: {% if section.settings.heading_italic %}italic{% else %}normal{% endif %};
    {% if section.settings.heading_uppercase %}text-transform: uppercase; letter-spacing: 0.08em;{% else %}text-transform: none;{% endif %}
    line-height: 1;
    margin: 0;
    padding: 0;
    border: 0;
    color: {{ heading_color }};
    text-align: center;
  }
  #shopify-section-{{ id }} .ak-heading-text__eyebrow {
    flex: 1 1 0;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    border: 0;
    line-height: 1;
  }
  #shopify-section-{{ id }} .ak-heading-text__eyebrow--left {
    font-family: {{ eyebrow_left_font_stack }};
    font-size: {{ ht_eb_l }}px;
    font-weight: {{ section.settings.eyebrow_left_font_weight | default: '400' }};
    font-style: {% if section.settings.eyebrow_left_italic %}italic{% else %}normal{% endif %};
    {% if section.settings.eyebrow_left_uppercase %}text-transform: uppercase; letter-spacing: 0.08em;{% else %}text-transform: none;{% endif %}
    color: {{ eyebrow_left_color }};
    text-align: left;
    padding-left: {{ eyebrow_pad_l }}px;
    padding-right: 0;
  }
  #shopify-section-{{ id }} .ak-heading-text__eyebrow--right {
    font-family: {{ eyebrow_right_font_stack }};
    font-size: {{ ht_eb_r }}px;
    font-weight: {{ section.settings.eyebrow_right_font_weight | default: '400' }};
    font-style: {% if section.settings.eyebrow_right_italic %}italic{% else %}normal{% endif %};
    {% if section.settings.eyebrow_right_uppercase %}text-transform: uppercase; letter-spacing: 0.08em;{% else %}text-transform: none;{% endif %}
    color: {{ eyebrow_right_color }};
    text-align: right;
    padding-right: {{ eyebrow_pad_r }}px;
    padding-left: 0;
  }
  #shopify-section-{{ id }} .ak-heading-text__body-wrap {
    margin-top: {% if heading != blank or eyebrow_left != blank or eyebrow_right != blank %}1rem{% else %}0{% endif %};
    max-width: {{ max_w_text }}rem;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: {{ text_align }};
    box-sizing: border-box;
  }
  #shopify-section-{{ id }} .ak-heading-text__rte {
    font-family: {{ body_font_stack }};
    font-size: {{ ht_b }}px;
    font-weight: {{ section.settings.body_font_weight | default: '400' }};
    line-height: {{ ht_lh }}%;
  }
  #shopify-section-{{ id }} .ak-heading-text__rte p {
    margin: 0 0 0.75em;
  }
  #shopify-section-{{ id }} .ak-heading-text__rte p:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ id }} .ak-heading-text__rte a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  #shopify-section-{{ id }} .ak-heading-text__rte a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }
  #shopify-section-{{ id }} .ak-heading-text__attr {
    display: block;
    margin-top: 1.25rem;
    font-family: {{ attr_font_stack }};
    font-size: {{ ht_attr }}px;
    font-weight: {{ section.settings.attribution_font_weight | default: '400' }};
    color: {{ attr_color }};
  }
  @media only screen and (max-width: 798px) {
    #shopify-section-{{ id }} .ak-heading-text {
      padding-left: {{ pad_x_m }}px;
      padding-right: {{ pad_x_m }}px;
    }
    #shopify-section-{{ id }} .ak-heading-text__caption-row {
      flex-direction: column;
      align-items: stretch;
      gap: {{ eyebrow_gap_m }}px;
    }
    #shopify-section-{{ id }} .ak-heading-text__heading {
      order: 1;
      flex: 0 0 auto;
      width: 100%;
      font-size: {{ ht_h_m }}px;
    }
    #shopify-section-{{ id }} .ak-heading-text__eyebrow--left {
      order: 2;
      flex: 0 0 auto;
      width: 100%;
      max-width: 100%;
      text-align: center;
      font-size: {{ ht_eb_l_m }}px;
      padding-left: {{ eyebrow_pad_l_m }}px;
      padding-right: {{ eyebrow_pad_l_m }}px;
    }
    #shopify-section-{{ id }} .ak-heading-text__eyebrow--right {
      order: 3;
      flex: 0 0 auto;
      width: 100%;
      max-width: 100%;
      text-align: center;
      font-size: {{ ht_eb_r_m }}px;
      padding-left: {{ eyebrow_pad_r_m }}px;
      padding-right: {{ eyebrow_pad_r_m }}px;
    }
    #shopify-section-{{ id }} .ak-heading-text__body-wrap {
      max-width: {{ max_w_text_m }}rem;
    }
    #shopify-section-{{ id }} .ak-heading-text__rte {
      font-size: {{ ht_b_m }}px;
      line-height: {{ ht_lh_m }}%;
    }
    #shopify-section-{{ id }} .ak-heading-text__attr {
      font-size: {{ ht_attr_m }}px;
    }
  }
{% endstyle %}

<section
  class="section is-width-{{ section.settings.width | default: 'wide' }} ak-campaign-heading-text-section {% if section.settings.show_gutter == false %}has-no-side-gutter has-background{% else %}has-gutter-enabled{% endif %}"
  id="shopify-section-{{ id }}"
  role="region"
  {% if heading != blank %}
    aria-labelledby="ak-heading-text-heading-{{ id }}"
  {% elsif section.settings.section_aria_label != blank %}
    aria-label="{{ section.settings.section_aria_label | escape }}"
  {% else %}
    aria-label="Campaign heading"
  {% endif %}
>
  <div class="container equal-columns--outside-trim">
    <div class="ak-heading-text">
      {% if heading != blank or eyebrow_left != blank or eyebrow_right != blank %}
        <div class="ak-heading-text__caption-row">
          {% if eyebrow_left != blank %}
            <p class="ak-heading-text__eyebrow ak-heading-text__eyebrow--left">{{ eyebrow_left | escape }}</p>
          {% else %}
            <span class="ak-heading-text__eyebrow ak-heading-text__eyebrow--left" aria-hidden="true"></span>
          {% endif %}
          {% if heading != blank %}
            {% if hl == 'h1' %}
              <h1 class="ak-heading-text__heading" id="ak-heading-text-heading-{{ id }}">{{ heading | escape }}</h1>
            {% elsif hl == 'h3' %}
              <h3 class="ak-heading-text__heading" id="ak-heading-text-heading-{{ id }}">{{ heading | escape }}</h3>
            {% else %}
              <h2 class="ak-heading-text__heading" id="ak-heading-text-heading-{{ id }}">{{ heading | escape }}</h2>
            {% endif %}
          {% else %}
            <span class="ak-heading-text__heading" aria-hidden="true"></span>
          {% endif %}
          {% if eyebrow_right != blank %}
            <p class="ak-heading-text__eyebrow ak-heading-text__eyebrow--right">{{ eyebrow_right | escape }}</p>
          {% else %}
            <span class="ak-heading-text__eyebrow ak-heading-text__eyebrow--right" aria-hidden="true"></span>
          {% endif %}
        </div>
      {% endif %}
      {% if body_rt != blank or attr != blank %}
        <div class="ak-heading-text__body-wrap">
          {% if body_rt != blank %}
            <div class="ak-heading-text__rte rte">{{ body_rt }}</div>
          {% endif %}
          {% if attr != blank %}
            <footer class="ak-heading-text__attr">— {{ attr | escape }}</footer>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AK Campaign heading text",
  "class": "shopify-section--ak-campaign-heading-text",
  "settings": [
    {
      "type": "paragraph",
      "content": "Desktop: left eyebrow | centered heading | right eyebrow (baseline-aligned). Mobile stacks heading → left → right."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (centered)",
      "default": "BY THE HOUR"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow_left",
      "label": "Left eyebrow",
      "default": "Fall / Winter 2026 Campaign"
    },
    {
      "type": "text",
      "id": "eyebrow_right",
      "label": "Right eyebrow",
      "default": "Starring Olivia Munn"
    },
    {
      "type": "range",
      "id": "eyebrow_gap_desktop",
      "label": "Gap between caption items (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_gap_mobile",
      "label": "Gap between caption items (mobile)",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_left_padding",
      "label": "Left eyebrow inset (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_left_padding_mobile",
      "label": "Left eyebrow inset (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px",
      "info": "0 = same as desktop."
    },
    {
      "type": "range",
      "id": "eyebrow_right_padding",
      "label": "Right eyebrow inset (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_right_padding_mobile",
      "label": "Right eyebrow inset (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px",
      "info": "0 = same as desktop."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body (optional)"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution (optional)",
      "info": "e.g. Name; appears below body with an em dash."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Body text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Body max width (desktop)",
      "min": 28,
      "max": 72,
      "step": 1,
      "default": 48,
      "unit": "rem",
      "info": "Only constrains body/attribution; heading + eyebrows use full section width."
    },
    {
      "type": "range",
      "id": "content_max_width_mobile",
      "label": "Body max width (mobile)",
      "min": 0,
      "max": 72,
      "step": 1,
      "default": 0,
      "unit": "rem",
      "info": "0 = same as desktop."
    },
    {
      "type": "range",
      "id": "content_padding_x",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_padding_x_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 10,
      "unit": "px",
      "info": "Left and right inset at ≤798px."
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "select",
      "id": "heading_font_family",
      "label": "Heading font",
      "default": "helvetica",
      "options": [
        { "value": "system", "label": "System sans" },
        { "value": "amiri", "label": "Amiri" },
        { "value": "arial", "label": "Arial" },
        { "value": "georgia", "label": "Georgia" },
        { "value": "times", "label": "Times New Roman" },
        { "value": "verdana", "label": "Verdana" },
        { "value": "trebuchet", "label": "Trebuchet MS" },
        { "value": "helvetica", "label": "Helvetica Neue" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 0,
      "max": 56,
      "step": 1,
      "default": 0,
      "unit": "px",
      "info": "0 = same as desktop."
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "default": "400",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "checkbox",
      "id": "heading_italic",
      "label": "Heading italic",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading uppercase",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Left eyebrow typography"
    },
    {
      "type": "select",
      "id": "eyebrow_left_font_family",
      "label": "Left eyebrow font",
      "default": "helvetica",
      "options": [
        { "value": "system", "label": "System sans" },
        { "value": "amiri", "label": "Amiri" },
        { "value": "arial", "label": "Arial" },
        { "value": "georgia", "label": "Georgia" },
        { "value": "times", "label": "Times New Roman" },
        { "value": "verdana", "label": "Verdana" },
