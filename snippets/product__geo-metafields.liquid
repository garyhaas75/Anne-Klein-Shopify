{% if product.metafields.custom.why_it_works.value != blank or 
          product.metafields.custom.compatibility.value != blank or 
          product.metafields.custom.care_notes.value != blank or 
          product.metafields.custom.fit_guidance.value != blank or 
          product.metafields.custom.use_cases.value != blank or 
          product.metafields.custom.buyer_questions.value != blank %}

<div class="section">

    {% if product.metafields.custom.why_it_works.value != blank or 
          product.metafields.custom.compatibility.value != blank or 
          product.metafields.custom.care_notes.value != blank or 
          product.metafields.custom.fit_guidance.value != blank or 
          product.metafields.custom.use_cases.value != blank %}

    <div id="full-details" class="product__geo-metafields">
        <div class="main-accordion pdp-tabs">
            <div class="accordion">
                <button class="heading active" aria-expanded="true">Full Details</button>
                <div class="content">

                    {% if product.metafields.custom.why_it_works.value != blank %}
                    <h4 aria-level="2" role="heading" style="margin-bottom: 0.5rem;">Why It Works</h4>
                    <p><strong style="font-weight: 500;">{{ product.metafields.custom.why_it_works.value.headline }}</strong></p>
                    <ul class="geo-list">
                        {% for list in product.metafields.custom.why_it_works.value.reasons %}
                            <li>{{ list }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}

                    {% if product.metafields.custom.use_cases.value != blank %}
                    <h4 aria-level="2" role="heading">Use Cases</h4>
                    <ul class="geo-list geo-bubbles">
                    {% for list in product.metafields.custom.use_cases.value %}
                        <li>{{ list }}</li>
                    {% endfor %}
                    </ul>
                    {% endif %}

                    {% if product.metafields.custom.compatibility.value != blank %}

                    {% assign compatibility_data = product.metafields.custom.compatibility.value %}
                    {% assign pairs = compatibility_data.pairs_with %}
                    {% assign contexts = compatibility_data.outfit_contexts %}

                    <h4 aria-level="2" role="heading">Compatibility</h4>
                    <ul class="geo-list">
                    
                        <li><strong style="text-transform:capitalize">Pairs With:</strong> 
                        {% for pair in pairs %}
                        {{ pair.item }}{% unless forloop.last %}, {% endunless %}
                        {% endfor %}
                        </li>

                        <li><strong style="text-transform:capitalize">Outfit Contexts:</strong> 
                        {% for context in contexts %}
                        {{ context }}{% unless forloop.last %}, {% endunless %}
                        {% endfor %}
                        </li>
                    
                    </ul>
                    {% endif %}
                    

                    {% if product.metafields.custom.fit_guidance.value != blank %}
                    <h4 aria-level="2" role="heading">Fit Logic</h4>

                    {% assign fit_guidance_data = product.metafields.custom.fit_guidance.value %}
                    {% assign silhouette = fit_guidance_data.silhouette %}
                    {% assign best_for = fit_guidance_data.best_for %}
                    {% assign styling_tip = fit_guidance_data.styling_tip %}

                    <ul class="geo-list">
                    
                        {% if silhouette != blank %}<li><strong style="text-transform:capitalize">Silhouette:</strong> {{ silhouette }}</li>{% endif %}
                        {% if best_for != blank %}<li><strong style="text-transform:capitalize">Best For:</strong> {{ best_for }}</li>{% endif %}
                        {% if styling_tip != blank %}<li><strong style="text-transform:capitalize">Styling Tip:</strong> {{ styling_tip }}</li>{% endif %}

                    </ul>

                    {% endif %}

                    {% if product.metafields.custom.care_notes.value != blank %}

                    {% assign care_notes_data = product.metafields.custom.care_notes.value %}
                    {% assign fabric = care_notes_data.fabric %}
                    {% assign washing = care_notes_data.washing %}
                    {% assign drying = care_notes_data.drying %}
                    {% assign ironing = care_notes_data.ironing %}
                    {% assign special_notes = care_notes_data.special_notes %}

                    <h4 aria-level="2" role="heading">Care Notes</h4>

                    <ul class="geo-list">
                    
                        {% if fabric != blank %}<li><strong style="text-transform:capitalize">Fabric:</strong> {{ fabric }}</li>{% endif %}
                        {% if washing != blank %}<li><strong style="text-transform:capitalize">Washing:</strong> {{ washing }}</li>{% endif %}
                        {% if drying != blank %}<li><strong style="text-transform:capitalize">Drying:</strong> {{ drying }}</li>{% endif %}
                        {% if ironing != blank %}<li><strong style="text-transform:capitalize">Ironing:</strong> {{ ironing }}</li>{% endif %}
                        {% if special_notes != blank %}<li><strong style="text-transform:capitalize">Special Notes:</strong> {{ special_notes }}</li>{% endif %}

                    </ul>

                    {% endif %}

                    {% if product.metafields["global"]["country_of_origin"] %}
                    <h4 aria-level="2" role="heading">Country of Origin</h4>
                    <ul class="geo-list"><li>{{ product.metafields["global"]["country_of_origin"]}}</li></ul>
                    {% endif %}

                </div>
            </div>

            {% if product.metafields.custom.buyer_questions.value != blank %}

            <div class="accordion">
                <button class="heading active" aria-expanded="true">Customer Q&A</button>

                <div class="content">

                    <div class="faq-section">
                    {% for qa in product.metafields.custom.buyer_questions.value %}
                        <div class="faq-item">
                            <h4>{{ qa.question }}</h4>
                            <p>{{ qa.answer }}</p>
                        </div>
                    {% endfor %}
                    </div>

                </div>

            </div>
            {% endif %}

        </div>
    </div>

    {% endif %}
</div>

<style>
    .product__geo-metafields .content h4, .faq-section .faq-item h4 {
        font-family: 'Avenir Next', Helvetica, sans-serif;
        font-size: 16px;
        font-weight: 600;
    }
    
    .product__geo-metafields .main-accordion.pdp-tabs .accordion .heading {
        font-weight: 700;
    }
    .product__geo-metafields .main-accordion.pdp-tabs .content p:not(:last-child) {
          margin-bottom: 0em;
    }
    .product__geo-metafields .main-accordion.pdp-tabs .accordion .content p, .faq-section .faq-item h4 {
        padding-bottom: 15px;
    }
    .product__geo-metafields .main-accordion.pdp-tabs .accordion .content {
        margin-top: 0;
        padding-top: 10px;
        column-gap: 10%;
    }

    .faq-section {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        margin-bottom: 20px;
        align-items: stretch;
        gap: 15px;
    }
    .faq-section h3 {
        width: 100%;
        text-align: center;
        padding-bottom: 40px;
        letter-spacing: 0px;
    }
    .faq-item {
        width: calc(33.333% - 10px);
        padding: 20px;
        border: 1px solid #F2F2F2;
    }

    @media only screen and (max-width: 768px) {
        .product__geo-metafields .main-accordion.pdp-tabs .accordion .content { 
            column-count: 1;
        }
        .faq-item {
            width: 100%;
        }
    }
</style>
{% endif %}


