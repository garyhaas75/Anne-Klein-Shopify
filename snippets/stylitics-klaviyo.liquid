<script>

  function poll(isready, success, error, count, interval) {
  if (count === undefined) {
    count = 10000;
  }
  if (interval === undefined) {
    interval = 20;
  }
  if (isready()) {
    success();
    return;
  }
  // The call back isn't ready. We need to wait for it
  setTimeout(function(){
    if (!count) {
      // We have run out of retries
      if (error !== undefined) {
        error();
      }
    } else {
      // Try again
      poll(isready, success, error, count -1, interval);
    }
  }, interval);
}

